<script>
  import { post } from "$sources";
  let open = $state(true);
</script>

<title>Post, open</title>

<DataSource source={post} load="server" let:data>
  <article id="post">
    <h1>{data.title}</h1>
    <p id="body">{data.body}</p>
  </article>
  {#if open}<p id="extra">{slug} — {data.title}</p>{/if}
</DataSource>
<button id="more" onclick={() => open = !open}>More</button>

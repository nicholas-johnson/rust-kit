{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "account-demo",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--offline",
        "-q",
        "-p",
        "account-demo",
        "--",
        "serve",
        "127.0.0.1:3917"
      ],
      "port": 3917
    },
    {
      "name": "test-pages",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--offline", "-q", "-p", "test-pages", "--", "127.0.0.1:3918"],
      "port": 3918
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4180", "--bind", "127.0.0.1", "--directory", "site/dist"],
      "port": 4180
    },
    {
      "name": "account-demo-dev",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--offline",
        "-q",
        "-p",
        "rustkit-cli",
        "--",
        "dev",
        "--offline",
        "-p",
        "account-demo",
        "--addr",
        "127.0.0.1:3961"
      ],
      "port": 3961
    }
  ]
}
